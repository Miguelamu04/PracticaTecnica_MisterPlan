
{% extends 'base.twig' %}

{% block title %}Administrar reservas - MisterPlan{% endblock %}

{% block content %}
    <h1>Administrar reservas</h1>

    <table>
        <thead>
            <tr>
                <th scope="col">Huésped</th>
                <th scope="col">Alojamiento</th>
                <th scope="col">Estado</th>
                <th scope="col">Importe</th>
                <th scope="col">Detalles</th>
                <th scope="col">Acciones</th>
            </tr>
        </thead>

        <tbody id="manage-reservations-body">
            {% for reservation in reservations %}
                <tr>
                    <td>{{ reservation.nombre_huesped }}</td>
                    <td>{{ reservation.nombre_alojamiento }}</td>
                    <td>{{ {'pendiente': 'Pendiente', 'confirmada': 'Confirmada', 'cancelada': 'Cancelada'}[reservation.estado] ?? reservation.estado }}</td>
                    <td>{{ reservation.importe|number_format(2, ',', '.') }} €</td>
                    <td>
                        <a href="/reservations/{{ reservation.id }}">Ver detalles</a>
                    </td>
                    <td>
                        {% if reservation.estado != 'cancelada' %}
                            <button
                                type="button"
                                class="cancel-reservation"
                                data-id="{{ reservation.id }}"
                            >
                                Cancelar reserva
                            </button>
                        {% else %}
                            <span>Cancelada</span>
                        {% endif %}
                    </td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="6">No se han encontrado reservas.</td>
                </tr>
            {% endfor %}
        </tbody>
    </table>

    <p id="manage-message" role="status" aria-live="polite"></p>
    <script src="/js/manage_reservations.js" defer></script>
{% endblock %}
