
{% extends 'base.twig' %}

{% block title %}Reservations - MisterPlan{% endblock %}

{% block content %}
    <h1>Reservations</h1>
    
    <section aria-labelledby="create-reservation-title">
        <h2 id="create-reservation-title">Create Reservation</h2>

        <form id="create-reservation-form">
            <div>
                <label for="guest_name">Guest name</label>
                <input
                    type="text"
                    id="guest_name"
                    name="guest_name"
                    maxlength="150"
                    required
                >
            </div>

            <div>
                <label for="guest_email">Guest email</label>
                <input
                    type="email"
                    id="guest_email"
                    name="guest_email"
                    maxlength="254"
                    required
                >
            </div>

            <div>
                <label for="accommodation">Accommodation</label>
                <input
                    type="text"
                    id="accommodation"
                    name="accommodation"
                    maxlength="200"
                    required
                >
            </div>

            <div>
                <label for="check_in">Check-in</label>
                <input type="date" id="check_in" name="check_in" required>
            </div>

            <div>
                <label for="check_out">Check-out</label>
                <input type="date" id="check_out" name="check_out" required>
            </div>

            <div>
                <label for="amount">Amount (€)</label>
                <input
                    type="number"
                    id="amount"
                    name="amount"
                    min="0"
                    max="99999999.99"
                    step="0.01"
                    required
                >
            </div>

            <div>
                <label for="notes">Notes (optional)</label>
                <textarea id="notes" name="notes" rows="3"></textarea>
            </div>

            <button type="submit">Create reservation</button>
        </form>

        <p id="create-message" role="status" aria-live="polite"></p>
    </section>

    <form id="reservation-filters">
        <div>
            <label for="guest">Guest name</label>
            <input
                type="search"
                id="guest"
                name="guest"
                placeholder="Search by guest"
            >
        </div>

        <div>
            <label for="status">Status</label>
            <select id="status" name="status">
                <option value="">All statuses</option>
                <option value="pendiente">Pending</option>
                <option value="confirmada">Confirmed</option>
                <option value="cancelada">Cancelled</option>
            </select>
        </div>

        <div>
            <label for="start_date">From</label>
            <input type="date" id="start_date" name="start_date">
        </div>

        <div>
            <label for="end_date">To</label>
            <input type="date" id="end_date" name="end_date">
        </div>

        <button type="submit">Apply filters</button>
        <button type="reset">Clear filters</button>
    </form>

    <p id="filter-message" role="status" aria-live="polite"></p>

    <table>
        <thead>
            <tr>
                <th scope="col">Guest</th>
                <th scope="col">Accommodation</th>
                <th scope="col">Check-in</th>
                <th scope="col">Check-out</th>
                <th scope="col">Status</th>
                <th scope="col">Amount</th>
                <th scope="col">Details</th>
                <th scope="col">Actions</th>
            </tr>
        </thead>

        <tbody id="reservations-body">
            {% for reservation in reservations %}
                <tr>
                    <td>{{ reservation.nombre_huesped }}</td>
                    <td>{{ reservation.nombre_alojamiento }}</td>
                    <td>{{ reservation.fecha_entrada|date('d/m/Y') }}</td>
                    <td>{{ reservation.fecha_salida|date('d/m/Y') }}</td>
                    <td>{{ reservation.estado }}</td>
                    <td>{{ reservation.importe|number_format(2, ',', '.') }} €</td>
                    <td>
                        <a href="/reservations/{{ reservation.id }}">
                            View details
                        </a>
                    </td>                   
                    <td>
                        {% if reservation.estado != 'cancelada' %}
                            <button
                                type="button"
                                class="cancel-reservation"
                                data-id="{{ reservation.id }}"
                            >
                                Cancel reservation
                            </button>
                        {% else %}
                            <span>Cancelled</span>
                        {% endif %}
                    </td>

                </tr>
            {% else %}
                <tr>
                    <td colspan="8">No reservations found.</td>
                </tr>
            {% endfor %}
        </tbody>
    </table>
    <script src="/js/reservations.js" defer></script>
{% endblock %}
