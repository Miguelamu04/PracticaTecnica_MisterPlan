
{% extends 'base.twig' %}

{% block title %}Reservas - MisterPlan{% endblock %}

{% block content %}
    <h1>Reservas</h1>

    <form id="reservation-filters">
        <div>
            <label for="guest">Nombre del huésped</label>
            <input
                type="search"
                id="guest"
                name="guest"
                placeholder="Buscar por huésped"
            >
        </div>

        <div>
            <label for="status">Estado</label>
            <select id="status" name="status">
                <option value="">Todos los estados</option>
                <option value="pendiente">Pendiente</option>
                <option value="confirmada">Confirmada</option>
                <option value="cancelada">Cancelada</option>
            </select>
        </div>

        <div>
            <label for="start_date">Desde</label>
            <input type="date" id="start_date" name="start_date">
        </div>

        <div>
            <label for="end_date">Hasta</label>
            <input type="date" id="end_date" name="end_date">
        </div>

        <button type="submit">Aplicar filtros</button>
        <button type="reset">Borrar filtros</button>
    </form>

    <p id="filter-message" role="status" aria-live="polite"></p>

    <table>
        <thead>
            <tr>
                <th scope="col">Huésped</th>
                <th scope="col">Alojamiento</th>
                <th scope="col">Fecha de entrada</th>
                <th scope="col">Fecha de salida</th>
                <th scope="col">Estado</th>
                <th scope="col">Importe</th>
                <th scope="col">Detalles</th>
                <th scope="col">Acciones</th>
            </tr>
        </thead>

        <tbody id="reservations-body">
            {% for reservation in reservations %}
                <tr>
                    <td>{{ reservation.nombre_huesped }}</td>
                    <td>{{ reservation.nombre_alojamiento }}</td>
                    <td>{{ reservation.fecha_entrada|date('d/m/Y') }}</td>
                    <td>{{ reservation.fecha_salida|date('d/m/Y') }}</td>
                    <td>{{ {'pendiente': 'Pendiente', 'confirmada': 'Confirmada', 'cancelada': 'Cancelada'}[reservation.estado] ?? reservation.estado }}</td>
                    <td>{{ reservation.importe|number_format(2, ',', '.') }} €</td>
                    <td>
                        <a href="/reservations/{{ reservation.id }}">
                            Ver detalles
                        </a>
                    </td>
                    <td>
                        {% if reservation.estado != 'cancelada' %}
                            <button
                                type="button"
                                class="cancel-reservation"
                                data-id="{{ reservation.id }}"
                            >
                                Cancelar reserva
                            </button>
                        {% else %}
                            <span>Cancelada</span>
                        {% endif %}
                    </td>                   
                </tr>
            {% else %}
                <tr>
                    <td colspan="8">No se han encontrado reservas.</td>
                </tr>
            {% endfor %}
        </tbody>
    </table>
    <script src="/js/reservations.js" defer></script>
{% endblock %}
