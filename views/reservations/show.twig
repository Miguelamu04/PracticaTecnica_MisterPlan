
{% extends 'base.twig' %}

{% block title %}Detalles de la reserva - MisterPlan{% endblock %}

{% block content %}
    <h1>Detalles de la reserva</h1>

    <p>
        <a href="/reservations">Volver a las reservas</a>
    </p>

    <section>
        <h2>Datos del huésped</h2>

        <p><strong>Nombre:</strong> {{ reservation.nombre_huesped }}</p>
        <p><strong>Correo electrónico:</strong> {{ reservation.email_huesped }}</p>
    </section>

    <section>
        <h2>Datos de la reserva</h2>

        <p><strong>Alojamiento:</strong> {{ reservation.nombre_alojamiento }}</p>
        <p><strong>Fecha de entrada:</strong> {{ reservation.fecha_entrada|date('d/m/Y') }}</p>
        <p><strong>Fecha de salida:</strong> {{ reservation.fecha_salida|date('d/m/Y') }}</p>
        <p><strong>Estado:</strong> {{ {'pendiente': 'Pendiente', 'confirmada': 'Confirmada', 'cancelada': 'Cancelada'}[reservation.estado] ?? reservation.estado }}</p>
        <p><strong>Importe:</strong> {{ reservation.importe|number_format(2, ',', '.') }} €</p>
        <p><strong>Creada el:</strong> {{ reservation.fecha_creacion|date('d/m/Y H:i') }}</p>

        {% if reservation.notas %}
            <p><strong>Notas:</strong> {{ reservation.notas }}</p>
        {% endif %}
    </section> 
    <section>
        <h2>Historial de la reserva</h2>

        {% if events is not empty %}
            <ol>
                {% for event in events %}
                    <li>
                        <strong>{{ {'creacion': 'Creación', 'confirmacion': 'Confirmación', 'cancelacion': 'Cancelación'}[event.tipo] ?? event.tipo|capitalize }}</strong>
                        <p>{{ event.descripcion }}</p>
                        <time datetime="{{ event.fecha_creacion|date('Y-m-d\\TH:i:s') }}">
                            {{ event.fecha_creacion|date('d/m/Y H:i') }}
                        </time>
                    </li>
                {% endfor %}
            </ol>
        {% else %}
            <p>No se han encontrado eventos para esta reserva.</p>
        {% endif %}
    </section>

{% endblock %}
